      "metadata": {
        "domain": "chemistry",
        "dress": "natural",
        "language": "fr"
      }
    },
    {
      "prompt_id": "chemistry_ja",
      "chat": [
        {
          "role": "user",
          "content": "次の反応を完成させて説明してください：2H₂ + O₂ → ?"
