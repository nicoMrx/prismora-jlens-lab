      "metadata": {
        "domain": "math",
        "dress": "natural",
        "language": "fr"
      }
    },
    {
      "prompt_id": "equation_ja",
      "chat": [
        {
          "role": "user",
          "content": "x^2 - 5x + 6 = 0 を解き、推論を示してください。"
        }
      ],
      "metadata": {
        "domain": "math",
        "dress": "natural",
        "language": "ja"
      }
    },
    {
      "prompt_id": "chemistry_naked",
      "prompt": "2H₂ + O₂ → ?",
      "metadata": {
        "domain": "chemistry",
        "dress": "naked",
        "language": "formal"
      }
    },
    {
      "prompt_id": "chemistry_en",
      "chat": [
        {
