{
  "schema": "prismora.experiment/v2",
  "experiment_id": "formal-language-boundary-01",
  "title": "Naked versus language-dressed formal problems",
  "description": "Separates formal notation from surrounding natural language to test when model-specific lexical read-outs appear.",
  "tags": [
    "formal-language",
    "mathematics",
    "chemistry",
    "multilingual"
  ],
  "hypothesis": {
    "primary": "Late semantic specialization persists for naked formal problems, while its lexical language profile changes when natural-language instructions are added.",
    "falsifiers": [
      "Naked and dressed conditions are indistinguishable at all eligible depths.",
      "Any apparent language profile is explained entirely by prompt-copy tokens."
    ],
    "exploratory": [
      "Compare equations with chemical formulas.",
      "Measure simplified-Chinese, Japanese-specific and Latin-script families separately."
    ]
  },
