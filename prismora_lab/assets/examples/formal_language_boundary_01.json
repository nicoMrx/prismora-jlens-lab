        "language": "formal"
      }
    },
    {
      "prompt_id": "equation_en",
      "chat": [
        {
          "role": "user",
          "content": "Solve x^2 - 5x + 6 = 0. Show the reasoning."
        }
      ],
      "metadata": {
        "domain": "math",
        "dress": "natural",
        "language": "en"
      }
    },
    {
      "prompt_id": "equation_fr",
      "chat": [
        {
          "role": "user",
