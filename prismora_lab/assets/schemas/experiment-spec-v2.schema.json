{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prismora.local/schemas/experiment-spec-v2.schema.json",
  "title": "Prismora ExperimentSpec v2",
  "type": "object",
  "required": [
    "schema", "experiment_id", "title", "hypothesis", "preregistration",
    "models", "prompts", "matrix", "generation", "readout", "analysis"
  ],
  "properties": {
    "schema": {"const": "prismora.experiment/v2"},
    "experiment_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,79}$"},
    "title": {"type": "string", "minLength": 3, "maxLength": 240},
    "description": {"type": "string", "maxLength": 10000, "default": ""},
    "tags": {"type": "array", "items": {"type": "string", "maxLength": 80}, "uniqueItems": true, "default": []},
    "hypothesis": {
      "type": "object",
      "required": ["primary", "falsifiers"],
      "properties": {
        "primary": {"type": "string", "minLength": 3, "maxLength": 5000},
        "falsifiers": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 2000}, "minItems": 1},
        "exploratory": {"type": "array", "items": {"type": "string", "maxLength": 2000}, "default": []}
      },
      "additionalProperties": false
    },
    "preregistration": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"type": "string", "enum": ["draft", "locked"]},
        "locked_at": {"type": ["string", "null"], "format": "date-time", "default": null},
        "spec_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$", "default": null},
        "amendments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["at", "reason"],
            "properties": {
              "at": {"type": "string", "format": "date-time"},
              "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
              "previous_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
            },
            "additionalProperties": false
          },
          "default": []
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "locked"}}, "required": ["status"]},
          "then": {"required": ["spec_sha256"], "properties": {"spec_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}
        }
      ],
      "additionalProperties": false
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/model"}
    },
    "prompts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/prompt"}
    },
    "matrix": {
      "type": "object",
      "required": ["factors", "repeats"],
      "properties": {
        "factors": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {"type": ["string", "number", "integer", "boolean", "null"]}
          },
          "default": {}
        },
        "bindings": {
          "type": "object",
          "additionalProperties": {"type": "string", "pattern": "^(generation|readout|intervention)\\.[A-Za-z0-9_.-]+$"},
          "default": {}
        },
        "repeats": {"type": "integer", "minimum": 1, "maximum": 100, "default": 1}
      },
      "additionalProperties": false
    },
    "generation": {"$ref": "#/$defs/generation"},
    "readout": {"$ref": "#/$defs/readout"},
    "intervention": {"$ref": "#/$defs/intervention"},
    "analysis": {
      "type": "object",
      "required": ["primary_metric"],
      "properties": {
        "primary_metric": {"type": "string", "minLength": 1, "maxLength": 240},
        "secondary_metrics": {"type": "array", "items": {"type": "string", "maxLength": 240}, "default": []},
        "exclusions": {"type": "array", "items": {"type": "string", "maxLength": 1000}, "default": []},
        "compare_absolute_and_relative_depth": {"type": "boolean", "default": true},
        "semantic_families": {
          "type": "object",
          "additionalProperties": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "default": {}
        },
        "generated_positions_only": {"type": "boolean", "default": true},
        "presence_min_probability": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.01},
        "notes": {"type": "string", "maxLength": 10000, "default": ""}
      },
      "additionalProperties": true
    },
    "stopping_rule": {"type": "string", "maxLength": 3000, "default": "Complete the preregistered matrix unless a safety or infrastructure failure occurs."},
    "metadata": {"type": "object", "additionalProperties": true, "default": {}}
  },
  "additionalProperties": false,
  "$defs": {
    "model": {
      "type": "object",
      "required": ["alias", "model_id", "backend"],
      "properties": {
        "alias": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
        "model_id": {"type": "string", "minLength": 1, "maxLength": 240},
        "backend": {"type": "string", "enum": ["mock", "neuronpedia", "worker"]},
        "blind_alias": {"type": ["string", "null"], "maxLength": 64, "default": null},
        "organization": {"type": ["string", "null"], "maxLength": 240, "default": null},
        "origin_region": {"type": ["string", "null"], "maxLength": 120, "default": null},
        "model_type": {"type": "string", "enum": ["base", "instruct", "reasoning", "unknown"], "default": "unknown"},
        "revision": {"type": ["string", "null"], "maxLength": 240, "default": null},
        "tokenizer_revision": {"type": ["string", "null"], "maxLength": 240, "default": null},
        "lens_id": {"type": ["string", "null"], "maxLength": 240, "default": null},
        "lens_revision": {"type": ["string", "null"], "maxLength": 240, "default": null},
        "precision": {"type": ["string", "null"], "maxLength": 40, "default": null},
        "quantization": {"type": ["string", "null"], "maxLength": 80, "default": null},
        "metadata": {"type": "object", "additionalProperties": true, "default": {}}
      },
      "additionalProperties": false
    },
    "message": {
      "type": "object",
      "required": ["role", "content"],
      "properties": {
        "role": {"type": "string", "enum": ["system", "user", "assistant"]},
        "content": {"type": "string", "maxLength": 10000}
      },
      "additionalProperties": false
    },
    "prompt": {
      "type": "object",
      "required": ["prompt_id"],
      "properties": {
        "prompt_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"},
        "prompt": {"type": "string", "maxLength": 10000},
        "chat": {"type": "array", "minItems": 1, "maxItems": 200, "items": {"$ref": "#/$defs/message"}},
        "metadata": {"type": "object", "additionalProperties": true, "default": {}}
      },
      "oneOf": [
        {"required": ["prompt"], "not": {"required": ["chat"]}},
        {"required": ["chat"], "not": {"required": ["prompt"]}}
      ],
      "additionalProperties": false
    },
    "generation": {
      "type": "object",
      "required": ["temperature", "max_new_tokens"],
      "properties": {
        "temperature": {"type": "number", "minimum": 0, "maximum": 2},
        "max_new_tokens": {"type": "integer", "minimum": 0, "maximum": 4096},
        "seed": {"type": ["integer", "null"], "default": null},
        "prepend_bos": {"type": "boolean", "default": true},
        "enable_thinking": {"type": "boolean", "default": false},
        "frequency_penalty": {"type": "number", "minimum": -2, "maximum": 2, "default": 0}
      },
      "additionalProperties": true
    },
    "readout": {
      "type": "object",
      "required": ["types", "top_k", "filter_nonword_tokens"],
      "properties": {
        "types": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "enum": ["LOGIT_LENS", "JACOBIAN_LENS"]}
        },
        "top_k": {"type": "integer", "minimum": 1, "maximum": 64},
        "filter_nonword_tokens": {"type": "boolean"},
        "exclude_first_n_positions": {"type": "integer", "minimum": 0, "maximum": 4096, "default": 0},
        "input_token_ids": {"type": "array", "minItems": 1, "maxItems": 131072, "items": {"type": "integer"}},
        "cached_token_ids": {"type": "array", "maxItems": 131072, "items": {"type": "integer"}}
      },
      "additionalProperties": true
    },
    "token_direction": {
      "type": "object",
      "required": ["token", "type"],
      "properties": {
        "token": {"type": "string", "maxLength": 256},
        "type": {"type": "string", "enum": ["LOGIT_LENS", "JACOBIAN_LENS"]}
      },
      "additionalProperties": false
    },
    "intervention": {
      "type": ["object", "null"],
      "properties": {
        "mode": {"type": "string", "enum": ["none", "steer", "swap", "ablate"], "default": "none"},
        "source_tokens": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/token_direction"}, "default": []},
        "target_token": {"anyOf": [{"$ref": "#/$defs/token_direction"}, {"type": "null"}], "default": null},
        "layers": {"type": "array", "maxItems": 512, "items": {"type": "integer"}, "default": []},
        "strength": {"type": ["number", "null"], "minimum": -50, "maximum": 50, "default": null},
        "apply_to_generated_tokens": {"type": "boolean", "default": false},
        "controls": {"type": "array", "items": {"type": "string", "maxLength": 240}, "default": []}
      },
      "additionalProperties": true
    }
  }
}
